{
  "extends": "../../tsconfig.base.json",

  "compilerOptions": {
    "target": "ES2022",

    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "rootDir": "src",
    "outDir": "dist",

    "noEmit": false,

    "declaration": false,
    "sourceMap": true,

    "types": ["node"],

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "resolveJsonModule": true,

    "skipLibCheck": true,

    "strict": true
  },

  "include": [
    "src/**/*.ts"
  ],

  "exclude": [
    "dist",
    "node_modules",
    "**/*.test.ts",
    "**/*.spec.ts",
    "src/test-supabase.ts"
  ]
}